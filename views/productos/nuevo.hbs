<div class="container">
  <h1>Nuevo Producto</h1>
  {{#if errores}}
  <ul class="alert-errores">
    {{#each errores}}<li>{{msg}}</li>{{/each}}
  </ul>
  {{/if}}
  <form action="/productos" method="POST" enctype="multipart/form-data" class="form">
    <div class="form-group">
      <label>Nombre *</label>
      <input type="text" name="nombre" value="{{body.nombre}}">
    </div>
    <div class="form-group">
      <label>Descripción</label>
      <textarea name="descripcion" rows="3">{{body.descripcion}}</textarea>
    </div>
    <div class="form-group">
      <label>Precio *</label>
      <input type="number" name="precio" min="0" step="0.01" value="{{body.precio}}">
    </div>
    <div class="form-group">
      <label>Imagen</label>
      <input type="file" name="imagen" accept="image/*">
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Guardar</button>
      <a href="/productos" class="btn">Cancelar</a>
    </div>
  </form>
</div>
