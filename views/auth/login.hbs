<div class="auth-page">
  <div class="auth-card">

    <div class="auth-logo">
      <h2>Mi<span>Inventario</span></h2>
      <p>Ingresa tus credenciales para continuar</p>
    </div>

    {{> errores}}

    <form action="/login" method="POST">
      <div class="form-group">
        <label>Correo electrónico</label>
        <input type="email" name="email" value="{{body.email}}"
               placeholder="correo@ejemplo.com" autofocus>
      </div>
      <div class="form-group">
        <label>Contraseña</label>
        <input type="password" name="password" placeholder="••••••">
      </div>

      <button type="submit" class="btn btn-primary btn-full" style="margin-top:.5rem">
        Iniciar sesión
      </button>
    </form>

    <hr class="divider">
    <p class="auth-link">¿No tienes cuenta? <a href="/registro">Regístrate aquí</a></p>
  </div>
</div>
