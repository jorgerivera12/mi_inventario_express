<div class="auth-container">
  <h1>Registro</h1>
  {{#if errores}}
  <ul class="alert-errores">
    {{#each errores}}<li>{{msg}}</li>{{/each}}
  </ul>
  {{/if}}
  <form action="/registro" method="POST" class="form">
    <div class="form-group">
      <label>Nombre</label>
      <input type="text" name="nombre" value="{{body.nombre}}" autofocus>
    </div>
    <div class="form-group">
      <label>Email</label>
      <input type="email" name="email" value="{{body.email}}">
    </div>
    <div class="form-group">
      <label>Contraseña</label>
      <input type="password" name="password" minlength="6">
    </div>
    <div class="form-group">
      <label>Confirmar contraseña</label>
      <input type="password" name="confirmar" minlength="6">
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Crear cuenta</button>
    </div>
    <p class="auth-link">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
  </form>
</div>
